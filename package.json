{
  "name": "@monoai/nscloud-nx-cache-action",
  "version": "0.1.4",
  "description": "CLI tools for Nx HTTP caching across local development, Namespace runners and hosted builds, with local archives, shared Artifact Storage and short-lived build credentials.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nscloud-nx-cache-action": "dist/nscloud-nx-cache-action.mjs",
    "nx-namespace-token": "dist/token.mjs"
  },
  "files": [
    "dist/nscloud-nx-cache-action.mjs",
    "dist/token.mjs",
    "docs/configuration.md",
    "docs/operations.md",
    "docs/vercel.md",
    "docs/benchmarking.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/monoai-labs/nscloud-nx-cache-action.git"
  },
  "homepage": "https://github.com/monoai-labs/nscloud-nx-cache-action#readme",
  "bugs": {
    "url": "https://github.com/monoai-labs/nscloud-nx-cache-action/issues"
  },
  "keywords": [
    "nx",
    "namespace",
    "cache",
    "cli",
    "github-actions"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check": "pnpm run config:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "config:check": "tsx scripts/validate-config.ts",
    "format": "oxfmt --write src scripts tests bench package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src scripts tests bench package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint --deny-warnings src scripts tests bench",
    "lint:fix": "pnpm run lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "fixture": "tsx scripts/generate-fixture.ts",
    "integration:restoration": "tsx scripts/integration-restoration.ts",
    "integration:contracts": "tsx scripts/contract-check.ts",
    "build": "tsx scripts/build.ts",
    "package:pack": "npm pack --pack-destination .output/npm",
    "publish:npm": "tsx scripts/publish-npm.ts",
    "bench:restoration:offline": "tsx bench/restoration/offline.ts",
    "bench:restoration:live": "tsx bench/restoration/run.ts",
    "bench:restoration:analyze": "tsx bench/restoration/analyze.ts"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.14.1",
    "@connectrpc/connect": "2.2.0",
    "@namespacelabs/sdk": "1.0.0",
    "@types/node": "^24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "nx": "23.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  }
}
