{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/monoai-labs/nscloud-nx-cache-action/schemas/actionlint.json",
  "title": "actionlint configuration",
  "type": "object",
  "properties": {
    "self-hosted-runner": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "config-variables": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ignore": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}